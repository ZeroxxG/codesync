# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- Django (apps/api) ---
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- PostgreSQL (only Django connects to this) ---
# When running locally on host, use localhost. Inside Docker Compose, POSTGRES_HOST is overridden to postgres.
POSTGRES_DB=codesync
POSTGRES_USER=codesync
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
# When running locally on host, use localhost. Inside Docker Compose, REDIS_URL is overridden to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Service-to-service auth (realtime <-> Django internal endpoints) ---
INTERNAL_API_TOKEN=CHANGE_ME
INTERNAL_API_URL=http://localhost:8000

# --- Realtime service (apps/realtime) ---
REALTIME_PORT=1234
MAX_DOCUMENT_BYTES=1048576
SNAPSHOT_DEBOUNCE_MS=3000

# --- Runner (apps/runner). It must NOT receive DJANGO_SECRET_KEY or POSTGRES_* values ---
RUNNER_CONCURRENCY=2
RUN_TIMEOUT_SECONDS=10
RUN_MEMORY_LIMIT_MB=128
RUN_CPU_LIMIT=0.5
RUN_PIDS_LIMIT=64
RUN_MAX_OUTPUT_BYTES=65536

# --- Rate limits (enforced by Django) ---
RUNS_PER_USER_PER_MINUTE=6
RUNS_PER_ROOM_PER_MINUTE=10
MAX_QUEUE_DEPTH=50

# --- Frontend (apps/web) ---
VITE_API_URL=http://localhost:8000
VITE_REALTIME_URL=ws://localhost:1234

# --- Optional Phase 5 feature flag ---
ENABLE_EXPLAIN_ERROR=false
LLM_API_KEY=
