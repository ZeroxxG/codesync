# ==============================================================================
# CodeSync Production Environment Configuration
# Copy this file to .env on your Azure VM (/opt/codesync/.env)
# ==============================================================================

# --- Django API ---
DJANGO_SECRET_KEY=replace-with-a-secure-random-key-at-least-50-chars-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app

# --- Azure Database for PostgreSQL Flexible Server ---
POSTGRES_HOST=codesync-pg.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=codesync
POSTGRES_USER=codesync
POSTGRES_PASSWORD=your_strong_postgres_password

# --- Redis & Celery (Internal VM Network) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Service-to-Service Internal Authentication ---
INTERNAL_API_TOKEN=replace-with-a-secure-random-token-at-least-32-chars-long
INTERNAL_API_URL=http://api:8000

# --- Celery Runner Docker Sandbox Images ---
SANDBOX_IMAGE_PYTHON=codesync-sandbox-python:latest
SANDBOX_IMAGE_JAVASCRIPT=codesync-sandbox-javascript:latest
SANDBOX_IMAGE_CPP=codesync-sandbox-cpp:latest

# --- Execution & Limits Configuration ---
EXECUTION_TIMEOUT_SECONDS=10
MEMORY_LIMIT=128m
MEMSWAP_LIMIT=128m
NANO_CPUS=500000000
PIDS_LIMIT=64
MAX_OUTPUT_BYTES=65536
MAX_DOCUMENT_BYTES=1048576

# --- Optional AI Assistant (Google Gemini) ---
GEMINI_API_KEY=
